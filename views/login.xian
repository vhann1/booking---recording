{{> head}}
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-center items-center p-4">
  
  <div class="w-full max-w-md">
    
    <!-- Branding Header -->
    <div class="text-center mb-6">
      <a href="/" class="inline-flex items-center space-x-2.5">
        <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white shadow-sm">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
        </div>
        <div class="text-left">
          <span class="font-bold text-xl text-slate-900 tracking-tight block">JailPersonnel</span>
          <span class="text-xs text-slate-500 block">Corrections Management System</span>
        </div>
      </a>
      <h2 class="mt-4 text-xl font-bold text-slate-900">Sign in to your account</h2>
      <p class="text-xs text-slate-500 mt-0.5">Enter your operational credentials to access the facility dashboard</p>
    </div>

    <!-- Login Card -->
    <div class="bg-white rounded-xl p-6 sm:p-8 border border-slate-200 shadow-md">
      
      {{#if error_msg}}
        <div class="flex items-center space-x-2.5 p-3 rounded-lg bg-red-50 border border-red-200 text-red-800 text-xs mb-4">
          <svg class="w-4 h-4 text-red-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <span>{{error_msg}}</span>
        </div>
      {{/if}}

      {{#if success_msg}}
        <div class="flex items-center space-x-2.5 p-3 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs mb-4">
          <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>{{success_msg}}</span>
        </div>
      {{/if}}

      <form method="POST" action="/login" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Official Email</label>
          <input type="email" name="email" required placeholder="admin@jailpersonnel.com" class="w-full px-3.5 py-2 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-sm transition" />
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider">Password</label>
            <a href="/forgot-password" class="text-xs text-blue-600 hover:underline">Forgot password?</a>
          </div>
          <input type="password" name="password" required placeholder="••••••••" class="w-full px-3.5 py-2 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-sm transition" />
        </div>

        <button type="submit" class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm rounded-lg shadow-sm transition mt-2">
          Sign In
        </button>
      </form>

      <!-- Default Credentials Quick Helper -->
      <div class="mt-6 pt-4 border-t border-slate-100">
        <div class="p-3 rounded-lg bg-slate-50 border border-slate-200 text-xs text-slate-600 space-y-0.5">
          <div class="text-[11px] font-semibold text-slate-700 flex items-center justify-between mb-1">
            <span>Default Administrator Credentials:</span>
            <span class="text-emerald-700 font-medium">Ready</span>
          </div>
          <div>Email: <strong class="text-slate-900 font-mono">admin@jailpersonnel.com</strong></div>
          <div>Password: <strong class="text-slate-900 font-mono">admin123</strong></div>
        </div>
      </div>

      <div class="text-center mt-4">
        <p class="text-xs text-slate-500">
          Need an account?
          <a href="/register" class="text-blue-600 hover:underline font-semibold ml-0.5">
            Register here
          </a>
        </p>
      </div>

    </div>

  </div>

  <footer class="mt-8 text-center text-xs text-slate-400">
    &copy; 2026 Mindoro State University • Jail Personnel System
  </footer>
</body>
</html>
