{{> head}}
<body class="min-h-screen flex flex-col justify-between p-4 sm:p-6 lg:p-10 font-sans antialiased">

  <!-- Top Utility Bar -->
  <div class="w-full max-w-5xl mx-auto flex items-center justify-between mb-4">
    <a href="/" class="inline-flex items-center space-x-2 text-xs font-semibold text-blue-800 hover:text-blue-600 bg-white/80 hover:bg-white px-3.5 py-2 rounded-lg border border-blue-200 shadow-2xs transition">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      <span>Back to Landing Page</span>
    </a>
    <div class="hidden sm:flex items-center space-x-2 text-xs text-blue-800/80 font-medium">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <span>Staff &amp; Officer Onboarding Portal</span>
    </div>
  </div>

  <!-- Main Landscape Register Container -->
  <main class="flex-1 flex items-center justify-center w-full">
    <div class="w-full max-w-5xl bg-white rounded-2xl border border-blue-200/90 shadow-xl overflow-hidden grid grid-cols-1 lg:grid-cols-12">

      <!-- Left Panel: Royal Blue Branding -->
      <div class="lg:col-span-5 bg-gradient-to-br from-blue-950 via-blue-900 to-sky-800 text-white p-7 sm:p-10 flex flex-col justify-between relative overflow-hidden">
        <div class="absolute -top-20 -right-20 w-64 h-64 rounded-full bg-sky-400/10 pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-16 w-72 h-72 rounded-full bg-blue-500/15 pointer-events-none"></div>

        <div class="relative z-10">
          <a href="/" class="inline-flex items-center space-x-3">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-blue-500 to-sky-400 flex items-center justify-center text-white shadow-md border border-sky-300/30">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <div>
              <span class="font-extrabold text-xl tracking-tight text-white block leading-none">JailPersonnel</span>
              <span class="text-xs text-sky-300 font-medium block mt-1">Booking &amp; Corrections System</span>
            </div>
          </a>

          <div class="mt-8">
            <div class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-full bg-blue-800/70 border border-sky-400/30 text-sky-200 text-[11px] font-semibold uppercase tracking-wider mb-3">
              <span>New Officer Registration</span>
            </div>
            <h1 class="text-2xl font-extrabold text-white leading-tight">
              Register Your Official Staff Account
            </h1>
            <p class="text-xs sm:text-sm text-blue-100/85 mt-2.5 leading-relaxed">
              Create your operator profile to log facility bookings, view duty assignments, record daily attendance, and manage compliance documentation.
            </p>
          </div>
        </div>

        <div class="relative z-10 mt-8 pt-5 border-t border-blue-800/80 text-xs text-blue-200/90 space-y-1.5">
          <div class="font-semibold text-white">Security &amp; Access Policy</div>
          <p class="text-[11px] text-blue-200/80 leading-relaxed">
            All account registrations and operational actions are automatically logged in the facility Audit Trail.
          </p>
        </div>
      </div>

      <!-- Right Panel: Registration Form -->
      <div class="lg:col-span-7 p-7 sm:p-10 flex flex-col justify-center bg-white">
        <div class="mb-5">
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600">Account Setup</span>
          <h2 class="text-2xl font-extrabold text-slate-900 mt-0.5">Create Staff Account</h2>
          <p class="text-xs text-slate-500 mt-1">Complete the fields below to gain immediate dashboard access.</p>
        </div>

        {{#if error_msg}}
          <div class="flex items-center space-x-2.5 p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-800 text-xs mb-5">
            <svg class="w-4 h-4 text-red-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <span class="font-medium">{{error_msg}}</span>
          </div>
        {{/if}}

        <form method="POST" action="/register" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Full Name</label>
              <input type="text" name="name" required placeholder="Officer Jane Doe" class="w-full px-3.5 py-2.5 bg-slate-50/70 border border-slate-300 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition" />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Official Email</label>
              <input type="email" name="email" required placeholder="jane.doe@jailfacility.gov" class="w-full px-3.5 py-2.5 bg-slate-50/70 border border-slate-300 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Password (Min 6 Chars)</label>
              <input type="password" name="password" minlength="6" required placeholder="••••••••" class="w-full px-3.5 py-2.5 bg-slate-50/70 border border-slate-300 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition" />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Confirm Password</label>
              <input type="password" name="passwordConfirm" minlength="6" required placeholder="••••••••" class="w-full px-3.5 py-2.5 bg-slate-50/70 border border-slate-300 rounded-xl text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition" />
            </div>
          </div>

          <div class="pt-2">
            <button type="submit" class="w-full py-3 px-4 bg-gradient-to-r from-blue-600 to-sky-500 hover:from-blue-700 hover:to-sky-600 text-white font-semibold text-sm rounded-xl shadow-md shadow-blue-600/20 transition cursor-pointer">
              Create Staff Account →
            </button>
          </div>
        </form>

        <div class="mt-6 pt-5 border-t border-slate-200/80 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-500">
          <div>
            Already have an account?
            <a href="/login" class="text-blue-600 hover:text-blue-700 font-bold hover:underline ml-1">
              Sign In Here
            </a>
          </div>
          <a href="/" class="text-slate-500 hover:text-blue-600 font-medium">
            Landing Page →
          </a>
        </div>
      </div>

    </div>
  </main>

  <footer class="mt-6 text-center text-xs text-slate-500">
    &copy; 2026 Mindoro State University • Jail Personnel &amp; Facility Booking System
  </footer>
</body>
</html>