{{> head}}
<body class="font-sans antialiased min-h-screen flex flex-col text-slate-800">

  <!-- Top Navigation Header -->
  <header class="w-full border-b border-blue-200/80 bg-white/90 backdrop-blur-md sticky top-0 z-50 shadow-2xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <!-- Brand Identity -->
      <a href="/" class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-700 via-blue-600 to-sky-500 flex items-center justify-center text-white font-bold shadow-sm">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
        </div>
        <div>
          <span class="font-extrabold text-lg text-slate-900 tracking-tight block leading-none">JailPersonnel</span>
          <span class="text-[11px] font-medium text-blue-600 block mt-0.5">Booking &amp; Operations System</span>
        </div>
      </a>

      <!-- Center Nav Links -->
      <nav class="hidden md:flex items-center space-x-6 text-xs font-semibold text-slate-600">
        <a href="#modules" class="hover:text-blue-600 transition">System Modules</a>
        <a href="#booking-workflow" class="hover:text-blue-600 transition">Booking Workflow</a>
        <a href="#reports-preview" class="hover:text-blue-600 transition">Excel Reports</a>
      </nav>

      <!-- Right Auth Buttons -->
      <div class="flex items-center space-x-3">
        {{#if user}}
          <a href="/dashboard" class="px-4 py-2 rounded-xl bg-gradient-to-r from-blue-600 to-sky-500 hover:from-blue-700 hover:to-sky-600 text-white font-semibold text-xs shadow-sm transition flex items-center space-x-1.5">
            <span>Open Dashboard</span>
            <span>→</span>
          </a>
        {{else}}
          <a href="/login" class="text-xs font-bold text-blue-800 hover:text-blue-600 px-3.5 py-2 rounded-xl hover:bg-blue-50 transition">
            Sign In
          </a>
          <a href="/register" class="px-4 py-2 rounded-xl bg-gradient-to-r from-blue-600 to-sky-500 hover:from-blue-700 hover:to-sky-600 text-white font-semibold text-xs shadow-sm transition">
            Create Account
          </a>
        {{/if}}
      </div>
    </div>
  </header>

  <main class="flex-1">

    <!-- Hero Section (Landscape 2-Column Layout) -->
    <section class="relative overflow-hidden py-12 sm:py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">

          <!-- Left Column: Headline & CTA -->
          <div class="lg:col-span-7 space-y-6 text-left">
            <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-blue-100/80 border border-blue-200 text-blue-800 text-xs font-bold">
              <span class="w-2 h-2 rounded-full bg-blue-600"></span>
              <span>Correctional Facility Booking, Roster &amp; Muster Platform</span>
            </div>

            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
              Unified Facility Booking &amp; <span class="text-blue-600">Personnel Command</span> for Correctional Operations
            </h1>

            <p class="text-sm sm:text-base text-slate-600 max-w-2xl leading-relaxed">
              Manage visitor and legal consultation bookings, issue printable gate passes, coordinate 24/7 officer shift assignments, track daily rollcall attendance, and export ready-to-print Excel reports in one integrated blue-themed command portal.
            </p>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
              {{#if user}}
                <a href="/dashboard" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-blue-600 to-sky-500 hover:from-blue-700 hover:to-sky-600 text-white font-bold text-sm shadow-md shadow-blue-600/20 transition text-center">
                  Go to Command Dashboard →
                </a>
              {{else}}
                <a href="/login" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-blue-600 to-sky-500 hover:from-blue-700 hover:to-sky-600 text-white font-bold text-sm shadow-md shadow-blue-600/20 transition flex items-center justify-center space-x-2">
                  <span>Staff &amp; Officer Sign In</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                  </svg>
                </a>
                <a href="/register" class="px-6 py-3.5 rounded-xl bg-white hover:bg-blue-50 text-blue-800 font-bold text-sm border border-blue-200 shadow-xs transition text-center">
                  Register Officer Account
                </a>
              {{/if}}
            </div>

            <!-- Quick Key Stats Strip -->
            <div class="grid grid-cols-3 gap-4 pt-4 border-t border-blue-200/70">
              <div>
                <div class="text-xl sm:text-2xl font-extrabold text-blue-900">24/7</div>
                <div class="text-xs text-slate-600 font-medium">Shift &amp; Gate Coverage</div>
              </div>
              <div>
                <div class="text-xl sm:text-2xl font-extrabold text-blue-600">Instant</div>
                <div class="text-xs text-slate-600 font-medium">Booking &amp; Gate Pass</div>
              </div>
              <div>
                <div class="text-xl sm:text-2xl font-extrabold text-sky-600">.XLS / .CSV</div>
                <div class="text-xs text-slate-600 font-medium">One-Click Excel Reports</div>
              </div>
            </div>
          </div>

          <!-- Right Column: Live Command & Booking Preview Card -->
          <div class="lg:col-span-5">
            <div class="bg-gradient-to-br from-blue-950 via-blue-900 to-indigo-950 rounded-2xl p-6 text-white shadow-2xl border border-blue-800/80 space-y-5">
              <!-- Card Header -->
              <div class="flex items-center justify-between border-b border-blue-800/80 pb-4">
                <div class="flex items-center space-x-2.5">
                  <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
                  <span class="text-xs font-bold tracking-wider uppercase text-sky-300">Live Operations Overview</span>
                </div>
                <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-blue-800 text-sky-200 border border-blue-700 font-medium">
                  Active Facility
                </span>
              </div>

              <!-- Mini KPI Row -->
              <div class="grid grid-cols-2 gap-3">
                <div class="p-3.5 rounded-xl bg-blue-900/60 border border-blue-700/60">
                  <div class="text-[11px] text-sky-300 font-semibold uppercase">Facility Bookings</div>
                  <div class="text-xl font-extrabold text-white mt-1">Gate &amp; Escort</div>
                  <div class="text-[11px] text-emerald-300 mt-0.5">● Check-In / Out Ready</div>
                </div>
                <div class="p-3.5 rounded-xl bg-blue-900/60 border border-blue-700/60">
                  <div class="text-[11px] text-sky-300 font-semibold uppercase">Officer Roster</div>
                  <div class="text-xl font-extrabold text-white mt-1">3 Daily Shifts</div>
                  <div class="text-[11px] text-sky-200 mt-0.5">● Muster Roll Logged</div>
                </div>
              </div>

              <!-- Sample Booking Pass Card Inside Preview -->
              <div class="p-4 rounded-xl bg-white/10 border border-sky-400/30 space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class="text-[11px] font-mono font-bold text-sky-300">REF: BKG-2026-1001</span>
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 uppercase">
                    Approved Pass
                  </span>
                </div>
                <div class="text-sm font-bold text-white">Legal Consultation &amp; Visitation</div>
                <div class="grid grid-cols-2 gap-2 text-[11px] text-blue-100/90 pt-1">
                  <div><span class="text-sky-300">Zone:</span> Visitation Room A</div>
                  <div><span class="text-sky-300">Schedule:</span> 09:00 - 10:30</div>
                </div>
              </div>

              <!-- Bottom Action Inside Card -->
              <div class="pt-1 flex items-center justify-between text-xs text-blue-200">
                <span>Ready to access the command portal?</span>
                <a href="/login" class="font-bold text-sky-300 hover:text-white underline">
                  Sign In Now →
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Booking Workflow Strip -->
    <section id="booking-workflow" class="py-12 bg-white/80 border-y border-blue-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-8">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-blue-600">End-to-End Booking Flow</span>
            <h2 class="text-2xl font-extrabold text-slate-900 mt-1">How Facility Booking &amp; Gate Control Works</h2>
          </div>
          <p class="text-xs text-slate-500 mt-2 md:mt-0">Streamlined 4-step workflow from reservation to Excel audit</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          <div class="p-5 rounded-xl bg-blue-50/70 border border-blue-200/90">
            <div class="w-8 h-8 rounded-lg bg-blue-600 text-white font-bold text-xs flex items-center justify-center mb-3">01</div>
            <h3 class="text-sm font-bold text-slate-900">Schedule Booking</h3>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed">Log visitor, lawyer, medical, or court escort details with valid ID and facility zone.</p>
          </div>

          <div class="p-5 rounded-xl bg-blue-50/70 border border-blue-200/90">
            <div class="w-8 h-8 rounded-lg bg-blue-600 text-white font-bold text-xs flex items-center justify-center mb-3">02</div>
            <h3 class="text-sm font-bold text-slate-900">Assign Escort &amp; Approve</h3>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed">Assign an active duty officer, check for zone conflicts, and approve with one click.</p>
          </div>

          <div class="p-5 rounded-xl bg-blue-50/70 border border-blue-200/90">
            <div class="w-8 h-8 rounded-lg bg-blue-600 text-white font-bold text-xs flex items-center justify-center mb-3">03</div>
            <h3 class="text-sm font-bold text-slate-900">Gate Check-In &amp; Print Pass</h3>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed">Record exact check-in and check-out timestamps and print official booking gate slips.</p>
          </div>

          <div class="p-5 rounded-xl bg-blue-50/70 border border-blue-200/90">
            <div class="w-8 h-8 rounded-lg bg-blue-600 text-white font-bold text-xs flex items-center justify-center mb-3">04</div>
            <h3 class="text-sm font-bold text-slate-900">Audit &amp; Excel Export</h3>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed">Download filtered booking logs, attendance sheets, and officer rosters in `.xls` format.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Core System Modules Grid (6 Modules) -->
    <section id="modules" class="py-14 sm:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600">Complete Operational Suite</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">All Facility Modules in One Sidebar</h2>
          <p class="text-xs sm:text-sm text-slate-600 mt-2">Designed with a clean, blended royal-blue interface for rapid daily use by correctional administrators and duty officers.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Module 1: Facility Bookings -->
          <div class="bg-white rounded-xl p-6 border border-blue-200 shadow-xs hover:shadow-md hover:border-blue-400 transition">
            <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center mb-4 shadow-xs">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
            </div>
            <h3 class="text-base font-bold text-slate-900 mb-1.5">Facility Bookings &amp; Gate Pass</h3>
            <p class="text-xs text-slate-600 leading-relaxed">Schedule inmate visitations, legal consultations, court transfers, and room reservations with one-click status updates and printable passes.</p>
          </div>

          <!-- Module 2: Personnel Directory -->
          <div class="bg-white rounded-xl p-6 border border-blue-200 shadow-xs hover:shadow-md hover:border-blue-400 transition">
            <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
            </div>
            <h3 class="text-base font-bold text-slate-900 mb-1.5">Personnel Directory</h3>
            <p class="text-xs text-slate-600 leading-relaxed">Maintain complete officer records including badge numbers, ranks, departments, emergency contacts, and active duty status.</p>
          </div>

          <!-- Module 3: Shift Assignments -->
          <div class="bg-white rounded-xl p-6 border border-blue-200 shadow-xs hover:shadow-md hover:border-blue-400 transition">
            <div class="w-10 h-10 rounded-xl bg-sky-100 text-sky-700 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
              </svg>
            </div>
            <h3 class="text-base font-bold text-slate-900 mb-1.5">Shift Assignments &amp; Posts</h3>
            <p class="text-xs text-slate-600 leading-relaxed">Deploy officers across cellblocks, perimeter towers, main gates, and medical units with automated conflict detection.</p>
          </div>

          <!-- Module 4: Muster Attendance -->
          <div class="bg-white rounded-xl p-6 border border-blue-200 shadow-xs hover:shadow-md hover:border-blue-400 transition">
            <div class="w-10 h-10 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="text-base font-bold text-slate-900 mb-1.5">Daily Muster Attendance</h3>
            <p class="text-xs text-slate-600 leading-relaxed">Record daily rollcall check-ins, time-out logs, tardiness, and official leave across all facility shifts.</p>
          </div>

          <!-- Module 5: Compliance Documents -->
          <div class="bg-white rounded-xl p-6 border border-blue-200 shadow-xs hover:shadow-md hover:border-blue-400 transition">
            <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
              </svg>
            </div>
            <h3 class="text-base font-bold text-slate-900 mb-1.5">Compliance Document Vault</h3>
            <p class="text-xs text-slate-600 leading-relaxed">Upload, verify, and track expiration dates for training certificates, medical clearances, and background checks.</p>
          </div>

          <!-- Module 6: Excel Reports & Audit -->
          <div id="reports-preview" class="bg-white rounded-xl p-6 border border-blue-200 shadow-xs hover:shadow-md hover:border-blue-400 transition">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </div>
            <h3 class="text-base font-bold text-slate-900 mb-1.5">Excel (.xls) Reports &amp; Audit Logs</h3>
            <p class="text-xs text-slate-600 leading-relaxed">Export formatted Excel spreadsheets for bookings, attendance, and personnel rosters alongside complete security audit trails.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Bottom CTA Banner -->
    <section class="pb-14 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto bg-gradient-to-r from-blue-950 via-blue-900 to-sky-800 rounded-2xl p-8 sm:p-10 text-white shadow-lg flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-1.5 text-center md:text-left">
          <h2 class="text-xl sm:text-2xl font-extrabold">Ready to manage facility bookings and personnel shifts?</h2>
          <p class="text-xs sm:text-sm text-blue-100/90">Sign in with your administrator or officer credentials to open the command dashboard.</p>
        </div>
        <div class="flex items-center space-x-3 flex-shrink-0">
          <a href="/login" class="px-5 py-3 rounded-xl bg-white text-blue-900 hover:bg-blue-50 font-bold text-xs sm:text-sm shadow-sm transition">
            Sign In to Portal →
          </a>
          <a href="/register" class="px-5 py-3 rounded-xl bg-blue-800/80 hover:bg-blue-700 text-white border border-sky-400/30 font-semibold text-xs sm:text-sm transition">
            Register Account
          </a>
        </div>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="mt-auto py-6 border-t border-blue-200/80 bg-white/90 text-xs text-slate-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-2">
      <div class="font-semibold text-slate-700">
        JailPersonnel — Correctional Facility &amp; Booking Management System
      </div>
      <div>
        &copy; 2026 Mindoro State University • All Rights Reserved
      </div>
    </div>
  </footer>
</body>
</html>