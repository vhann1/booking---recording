{{> head}}
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">
  
  <!-- Navbar -->
  <header class="w-full border-b border-slate-200 bg-white sticky top-0 z-50 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-2.5">
        <div class="w-9 h-9 rounded-xl bg-blue-600 flex items-center justify-center text-white font-bold shadow-sm">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
        </div>
        <div>
          <span class="font-bold text-lg text-slate-900 tracking-tight block">JailPersonnel</span>
          <span class="text-[10px] text-slate-500 block leading-tight">Operations Management</span>
        </div>
      </div>

      <div class="flex items-center space-x-3">
        {{#if user}}
          <a href="/dashboard" class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium text-xs shadow-sm transition flex items-center space-x-1.5">
            <span>Go to Dashboard →</span>
          </a>
        {{else}}
          <a href="/login" class="text-xs font-semibold text-slate-700 hover:text-blue-600 px-3 py-2 transition">
            Sign In
          </a>
          <a href="/register" class="px-3.5 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium text-xs shadow-sm transition">
            Register
          </a>
        {{/if}}
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <main class="flex-1 flex flex-col justify-center items-center px-4 py-16 sm:py-24 text-center">
    <div class="max-w-4xl mx-auto space-y-6">
      
      <!-- Facility Badge -->
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-semibold">
        <span class="w-2 h-2 rounded-full bg-blue-600"></span>
        <span>Correctional Facility Staff &amp; Operations Management</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Reliable Operations &amp; Shift Management for Modern Correctional Facilities
      </h1>

      <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Streamline personnel directories, shift rosters, daily rollcall muster, compliance documentation, and generate comprehensive Excel reports on demand.
      </p>

      <!-- Action CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        {{#if user}}
          <a href="/dashboard" class="w-full sm:w-auto px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm shadow-sm transition">
            Open Dashboard →
          </a>
        {{else}}
          <a href="/login" class="w-full sm:w-auto px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm shadow-sm transition">
            Staff &amp; Officer Sign In
          </a>
          <a href="/register" class="w-full sm:w-auto px-6 py-3 rounded-lg bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm border border-slate-300 shadow-sm transition">
            Create Account
          </a>
        {{/if}}
      </div>

      <!-- Feature Highlights -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-12 text-left">
        
        <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm hover:border-blue-300 transition">
          <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center mb-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-1">Personnel Directory</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Complete officer tracking, ranks, department affiliations, contact records, and service tenure history.</p>
        </div>

        <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm hover:border-blue-300 transition">
          <div class="w-10 h-10 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center mb-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-1">Shift Rosters &amp; Muster</h3>
          <p class="text-xs text-slate-500 leading-relaxed">24/7 post rotations, tower and cellblock coverage, daily rollcall check-ins, and tardiness logging.</p>
        </div>

        <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm hover:border-blue-300 transition">
          <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center mb-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h3 class="text-base font-bold text-slate-900 mb-1">Excel Reports &amp; Exports</h3>
          <p class="text-xs text-slate-500 leading-relaxed">Download styled Excel workbooks (.xls) and CSVs for audit compliance, payroll muster, and staffing summaries.</p>
        </div>

      </div>

    </div>
  </main>

  <!-- Clean Footer -->
  <footer class="mt-auto py-6 border-t border-slate-200 bg-white text-xs text-slate-500 text-center">
    <div class="max-w-7xl mx-auto px-4">
      &copy; 2026 Mindoro State University • Jail Personnel Management System
    </div>
  </footer>
</body>
</html>
