{{> head}}
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">
  {{> sidebar}}

  <div class="md:pl-64 flex-1 flex flex-col min-w-0">
    {{> topbar}}

    <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-3xl w-full mx-auto space-y-6">
      
      {{#if error_msg}}
        <div class="flex items-center space-x-3 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 shadow-sm">
          <svg class="w-5 h-5 text-red-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <span class="text-sm font-medium">{{error_msg}}</span>
        </div>
      {{/if}}

      <div class="bg-white rounded-xl p-6 sm:p-8 border border-slate-200 shadow-sm">
        <!-- Header -->
        <div class="mb-6 pb-4 border-b border-slate-200 flex items-center justify-between">
          <div>
            <h1 class="text-2xl font-bold text-slate-900">Edit Attendance Record</h1>
            <p class="text-sm text-slate-500 mt-0.5">
              Officer: <span class="text-slate-800 font-semibold">{{record.Personnel.firstName}} {{record.Personnel.lastName}}</span> ({{record.Personnel.employeeId}})
            </p>
          </div>
          <a href="/attendance" class="text-sm text-slate-500 hover:text-slate-800 font-medium">← Back to Logs</a>
        </div>

        <form method="POST" action="/attendance/edit/{{record.id}}" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Date *</label>
              <input type="date" name="date" value="{{formatDate record.date 'input'}}" required class="w-full px-3.5 py-2 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-sm transition" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Attendance Status *</label>
              <select name="status" required class="w-full px-3.5 py-2 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-sm transition">
                <option value="present" {{#if (eq record.status 'present')}}selected{{/if}}>Present on Duty</option>
                <option value="late" {{#if (eq record.status 'late')}}selected{{/if}}>Late Arrival</option>
                <option value="absent" {{#if (eq record.status 'absent')}}selected{{/if}}>Absent</option>
                <option value="early_leave" {{#if (eq record.status 'early_leave')}}selected{{/if}}>Early Departure</option>
                <option value="holiday" {{#if (eq record.status 'holiday')}}selected{{/if}}>Official Leave / Holiday</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Check-In Time</label>
              <input type="time" name="checkIn" value="{{record.checkIn}}" class="w-full px-3.5 py-2 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-sm transition" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Check-Out Time</label>
              <input type="time" name="checkOut" value="{{record.checkOut}}" class="w-full px-3.5 py-2 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-sm transition" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Supervisor Remarks</label>
            <textarea name="remarks" rows="3" class="w-full px-3.5 py-2 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-sm transition">{{record.remarks}}</textarea>
          </div>

          <div class="flex items-center gap-3 pt-4 border-t border-slate-200">
            <button type="submit" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm rounded-lg shadow-sm transition">
              Update Attendance
            </button>
            <a href="/attendance" class="px-4 py-2 bg-white hover:bg-slate-50 text-slate-700 font-medium text-sm rounded-lg border border-slate-300 shadow-sm transition">
              Cancel
            </a>
          </div>
        </form>
      </div>

    </main>

    {{> footer}}
  </div>
