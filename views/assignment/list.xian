{{> head}}
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">
  {{> sidebar}}

  <div class="md:pl-64 flex-1 flex flex-col min-w-0">
    {{> topbar}}

    <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto space-y-6">
      
      {{#if success_msg}}
        <div class="flex items-center space-x-3 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 shadow-sm">
          <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="text-sm font-medium">{{success_msg}}</span>
        </div>
      {{/if}}

      {{#if error_msg}}
        <div class="flex items-center space-x-3 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 shadow-sm">
          <svg class="w-5 h-5 text-red-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <span class="text-sm font-medium">{{error_msg}}</span>
        </div>
      {{/if}}

      <!-- Page Header -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-2 border-b border-slate-200">
        <div>
          <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Shift Deployments</h1>
          <p class="text-slate-500 text-sm mt-0.5">Manage guard postings across posts, cellblocks, gates, and perimeter towers</p>
        </div>

        <a href="/assignment/create" class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium text-xs shadow-sm transition flex items-center space-x-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
          </svg>
          <span>Create Shift Assignment</span>
        </a>
      </div>

      <!-- Filter Controls -->
      <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm">
        <form method="GET" action="/assignment" class="grid grid-cols-1 sm:grid-cols-4 gap-3">
          <div>
            <select name="personnelId" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-sm transition">
              <option value="">All Officers</option>
              {{#each personnel}}
                <option value="{{this.id}}" {{#if (eq (json this.id) (json ../filters.personnelId))}}selected{{/if}}>
                  {{this.firstName}} {{this.lastName}} ({{this.employeeId}})
                </option>
              {{/each}}
            </select>
          </div>

          <div>
            <select name="shiftId" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-sm transition">
              <option value="">All Shifts</option>
              {{#each shifts}}
                <option value="{{this.id}}" {{#if (eq (json this.id) (json ../filters.shiftId))}}selected{{/if}}>
                  {{this.name}} ({{this.startTime}} - {{this.endTime}})
                </option>
              {{/each}}
            </select>
          </div>

          <div>
            <select name="status" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-sm transition">
              <option value="">All Statuses</option>
              <option value="active" {{#if (eq filters.status 'active')}}selected{{/if}}>Active</option>
              <option value="completed" {{#if (eq filters.status 'completed')}}selected{{/if}}>Completed</option>
              <option value="cancelled" {{#if (eq filters.status 'cancelled')}}selected{{/if}}>Cancelled</option>
            </select>
          </div>

          <div class="flex gap-2">
            <button type="submit" class="flex-1 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold shadow-sm transition">
              Filter
            </button>
            <a href="/assignment" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-sm font-semibold transition flex items-center justify-center" title="Reset Filters">
              ↺
            </a>
          </div>
        </form>
      </div>

      <!-- Main Assignments Table -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
        {{#if assignments.length}}
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-700 uppercase tracking-wider">
                <tr>
                  <th class="px-5 py-3">Assigned Officer</th>
                  <th class="px-5 py-3">Shift &amp; Timings</th>
                  <th class="px-5 py-3">Department / Post</th>
                  <th class="px-5 py-3">Schedule Period</th>
                  <th class="px-5 py-3">Status</th>
                  <th class="px-5 py-3 text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-xs">
                {{#each assignments}}
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-5 py-3.5">
                      <a href="/personnel/view/{{this.Personnel.id}}" class="font-semibold text-slate-900 hover:text-blue-600 transition block">
                        {{this.Personnel.firstName}} {{this.Personnel.lastName}}
                      </a>
                      <div class="text-[11px] text-slate-400 font-mono">{{this.Personnel.employeeId}} • {{this.Personnel.designation}}</div>
                    </td>
                    <td class="px-5 py-3.5">
                      <div class="font-semibold text-slate-800">{{this.Shift.name}}</div>
                      <div class="text-[11px] text-slate-500 font-mono">{{this.Shift.startTime}} - {{this.Shift.endTime}}</div>
                    </td>
                    <td class="px-5 py-3.5">
                      <span class="inline-block px-2.5 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">
                        {{this.department}}
                      </span>
                      {{#if this.zone}}
                        <span class="ml-1 text-xs text-blue-700 font-medium">Post: {{this.zone}}</span>
                      {{/if}}
                    </td>
                    <td class="px-5 py-3.5 text-slate-500 whitespace-nowrap">
                      <div>From: {{formatDate this.startDate}}</div>
                      <div>To: {{#if this.endDate}}{{formatDate this.endDate}}{{else}}Ongoing{{/if}}</div>
                    </td>
                    <td class="px-5 py-3.5">
                      <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium uppercase
                        {{#if (eq this.status 'active')}}bg-emerald-50 text-emerald-700 border border-emerald-200
                        {{else if (eq this.status 'completed')}}bg-blue-50 text-blue-700 border border-blue-200
                        {{else}}bg-red-50 text-red-700 border border-red-200{{/if}}">
                        {{this.status}}
                      </span>
                    </td>
                    <td class="px-5 py-3.5 text-right space-x-1 whitespace-nowrap">
                      <a href="/assignment/edit/{{this.id}}" class="inline-block px-2.5 py-1 rounded bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs font-medium transition">
                        Edit
                      </a>
                      <form method="POST" action="/assignment/delete/{{this.id}}" style="display:inline;" onsubmit="return confirm('Remove this deployment assignment?')">
                        <button type="submit" class="px-2.5 py-1 rounded bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 text-xs font-medium transition">
                          Delete
                        </button>
                      </form>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>

          <!-- Pagination Bar -->
          <div class="flex items-center justify-between px-5 py-3 bg-slate-50 border-t border-slate-200 text-xs text-slate-600">
            <span>Showing page {{currentPage}} of {{totalPages}}</span>
            <div class="flex space-x-2">
              {{#if (gt currentPage 1)}}
                <a href="/assignment?page={{subtract currentPage 1}}" class="px-3 py-1 rounded bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 shadow-xs transition">
                  ← Previous
                </a>
              {{/if}}
              {{#if (lt currentPage totalPages)}}
                <a href="/assignment?page={{add currentPage 1}}" class="px-3 py-1 rounded bg-blue-600 hover:bg-blue-700 text-white font-medium shadow-xs transition">
                  Next →
                </a>
              {{/if}}
            </div>
          </div>
        {{else}}
          <div class="p-12 text-center text-slate-500 space-y-2">
            <svg class="mx-auto h-8 w-8 text-slate-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
            <p class="text-sm font-semibold text-slate-700">No shift assignments found</p>
            <a href="/assignment/create" class="inline-block text-xs font-medium text-blue-600 hover:underline">+ Create New Assignment</a>
          </div>
        {{/if}}
      </div>

    </main>

    {{> footer}}
  </div>
