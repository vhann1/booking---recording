{{> head}}
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">
  {{> sidebar}}

  <div class="md:pl-64 flex-1 flex flex-col min-w-0">
    {{> topbar}}

    <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto space-y-6">
      
      {{#if success_msg}}
        <div class="flex items-center space-x-3 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 shadow-sm">
          <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="text-sm font-medium">{{success_msg}}</span>
        </div>
      {{/if}}

      {{#if error_msg}}
        <div class="flex items-center space-x-3 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 shadow-sm">
          <svg class="w-5 h-5 text-red-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <span class="text-sm font-medium">{{error_msg}}</span>
        </div>
      {{/if}}

      <!-- Page Header -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-2 border-b border-slate-200">
        <div>
          <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Duty Shifts &amp; Gate Timings</h1>
          <p class="text-slate-500 text-sm mt-0.5">Configure 24/7 guard watch rotations, start and end hours, and break periods</p>
        </div>

        <a href="/shift/create" class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium text-xs shadow-sm transition flex items-center space-x-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
          </svg>
          <span>Add New Shift</span>
        </a>
      </div>

      <!-- Shift Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {{#each shifts}}
          <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm flex flex-col justify-between hover:border-blue-400 transition">
            <div>
              <div class="flex items-start justify-between mb-3">
                <div class="flex items-center space-x-3">
                  <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-base font-bold text-slate-900">{{this.name}}</h3>
                    <div class="text-xs text-slate-400 font-mono">Shift #{{this.id}}</div>
                  </div>
                </div>

                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium uppercase
                  {{#if (eq this.status 'active')}}bg-emerald-50 text-emerald-700 border border-emerald-200
                  {{else}}bg-slate-100 text-slate-600 border border-slate-200{{/if}}">
                  {{this.status}}
                </span>
              </div>

              <!-- Time & Details -->
              <div class="space-y-2 my-4 p-3.5 rounded-lg bg-slate-50 border border-slate-200 text-xs">
                <div class="flex items-center justify-between">
                  <span class="text-slate-500 font-medium">Duty Hours:</span>
                  <span class="text-blue-700 font-mono font-bold text-sm">{{this.startTime}} – {{this.endTime}}</span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-slate-500 font-medium">Break Allowance:</span>
                  <span class="text-slate-700 font-medium">{{this.breakDuration}} minutes</span>
                </div>
                {{#if this.description}}
                  <p class="text-xs text-slate-500 pt-2 border-t border-slate-200 italic">{{this.description}}</p>
                {{/if}}
              </div>
            </div>

            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-500">
                Assigned: <strong class="text-slate-800 font-semibold">{{this.activeAssignmentsCount}} officers</strong>
              </span>
              <div class="space-x-2">
                <a href="/shift/edit/{{this.id}}" class="text-blue-600 hover:text-blue-700 font-medium">Edit</a>
                <span class="text-slate-300">|</span>
                <form method="POST" action="/shift/delete/{{this.id}}" style="display:inline;" onsubmit="return confirm('Delete this shift rotation?')">
                  <button type="submit" class="text-red-600 hover:text-red-700 font-medium">Delete</button>
                </form>
              </div>
            </div>
          </div>
        {{/each}}
      </div>

    </main>

    {{> footer}}
  </div>
