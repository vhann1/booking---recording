{{> head}}
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">
  {{> sidebar}}

  <div class="md:pl-64 flex-1 flex flex-col min-w-0">
    {{> topbar}}

    <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-4xl w-full mx-auto space-y-6">
      
      {{#if error_msg}}
        <div class="flex items-center space-x-3 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 shadow-sm">
          <svg class="w-5 h-5 text-red-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <span class="text-sm font-medium">{{error_msg}}</span>
        </div>
      {{/if}}

      <div class="bg-white rounded-xl p-6 sm:p-8 border border-blue-200 shadow-sm">
        <!-- Header -->
        <div class="mb-6 pb-4 border-b border-blue-200 flex items-center justify-between">
          <div>
            <div class="inline-flex items-center space-x-2 px-2.5 py-0.5 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-semibold mb-1">
              <span>Modify Booking Record</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-900">Edit Booking: {{booking.bookingNumber}}</h1>
            <p class="text-sm text-slate-500 mt-0.5">Update subject information, facility zone, scheduled timings, or clearance status</p>
          </div>
          <a href="/booking/view/{{booking.id}}" class="text-sm text-blue-600 hover:text-blue-800 font-medium">← View Booking Pass</a>
        </div>

        <form method="POST" action="/booking/edit/{{booking.id}}" class="space-y-6">
          <!-- Section 1: Reference & Classification -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">Booking Reference (Locked)</label>
              <input type="text" value="{{booking.bookingNumber}}" disabled class="w-full px-3.5 py-2 bg-blue-50/60 border border-blue-200 rounded-lg text-sm text-blue-800 font-mono cursor-not-allowed" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Booking Type *</label>
              <select name="bookingType" required class="w-full px-3.5 py-2 bg-white border border-blue-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-xs transition">
                <option value="Visitation" {{#if (eq booking.bookingType 'Visitation')}}selected{{/if}}>Visitation Appointment</option>
                <option value="Inmate Intake" {{#if (eq booking.bookingType 'Inmate Intake')}}selected{{/if}}>Inmate Intake &amp; Processing</option>
                <option value="Legal Consultation" {{#if (eq booking.bookingType 'Legal Consultation')}}selected{{/if}}>Legal Consultation</option>
                <option value="Court Transport" {{#if (eq booking.bookingType 'Court Transport')}}selected{{/if}}>Court Escort &amp; Transport</option>
                <option value="Facility Room" {{#if (eq booking.bookingType 'Facility Room')}}selected{{/if}}>Facility &amp; Room Reservation</option>
                <option value="Medical Checkup" {{#if (eq booking.bookingType 'Medical Checkup')}}selected{{/if}}>Medical Bay Checkup</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Priority Level</label>
              <select name="priority" class="w-full px-3.5 py-2 bg-white border border-blue-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-xs transition">
                <option value="normal" {{#if (eq booking.priority 'normal')}}selected{{/if}}>Normal Priority</option>
                <option value="high" {{#if (eq booking.priority 'high')}}selected{{/if}}>High Priority</option>
                <option value="urgent" {{#if (eq booking.priority 'urgent')}}selected{{/if}}>Urgent / Immediate</option>
              </select>
            </div>
          </div>

          <!-- Section 2: Subject Information -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Full Name / Subject *</label>
              <input type="text" name="subjectName" value="{{booking.subjectName}}" required class="w-full px-3.5 py-2 bg-white border border-blue-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-xs transition" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Valid ID / Case Number</label>
              <input type="text" name="subjectIdNumber" value="{{booking.subjectIdNumber}}" class="w-full px-3.5 py-2 bg-white border border-blue-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-xs transition" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Contact Phone / Email</label>
              <input type="text" name="subjectContact" value="{{booking.subjectContact}}" class="w-full px-3.5 py-2 bg-white border border-blue-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-xs transition" />
            </div>
          </div>

          <!-- Section 3: Schedule & Zone -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Booking Date *</label>
              <input type="date" name="bookingDate" value="{{formatDate booking.bookingDate 'input'}}" required class="w-full px-3.5 py-2 bg-white border border-blue-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-xs transition" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Start Time *</label>
              <input type="time" name="startTime" value="{{booking.startTime}}" required class="w-full px-3.5 py-2 bg-white border border-blue-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-xs transition" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">End Time</label>
              <input type="time" name="endTime" value="{{booking.endTime}}" class="w-full px-3.5 py-2 bg-white border border-blue-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-xs transition" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Facility Zone / Room *</label>
              <input type="text" name="facilityZone" value="{{booking.facilityZone}}" required class="w-full px-3.5 py-2 bg-white border border-blue-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-xs transition" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Assigned Duty Officer</label>
              <select name="personnelId" class="w-full px-3.5 py-2 bg-white border border-blue-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-xs transition">
                <option value="">-- Unassigned --</option>
                {{#each personnel}}
                  <option value="{{this.id}}" {{#if (eq (json this.id) (json ../booking.personnelId))}}selected{{/if}}>
                    {{this.firstName}} {{this.lastName}} ({{this.employeeId}} - {{this.department}})
                  </option>
                {{/each}}
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Booking Status *</label>
              <select name="status" class="w-full px-3.5 py-2 bg-white border border-blue-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-xs transition">
                <option value="pending" {{#if (eq booking.status 'pending')}}selected{{/if}}>Pending Approval</option>
                <option value="approved" {{#if (eq booking.status 'approved')}}selected{{/if}}>Approved / Cleared</option>
                <option value="checked_in" {{#if (eq booking.status 'checked_in')}}selected{{/if}}>Checked-In</option>
                <option value="completed" {{#if (eq booking.status 'completed')}}selected{{/if}}>Completed</option>
                <option value="cancelled" {{#if (eq booking.status 'cancelled')}}selected{{/if}}>Cancelled</option>
              </select>
            </div>
          </div>

          <!-- Section 4: Purpose & Remarks -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Purpose of Booking</label>
              <textarea name="purpose" rows="3" class="w-full px-3.5 py-2 bg-white border border-blue-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-xs transition">{{booking.purpose}}</textarea>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Security Remarks / Clearance Notes</label>
              <textarea name="remarks" rows="3" class="w-full px-3.5 py-2 bg-white border border-blue-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-xs transition">{{booking.remarks}}</textarea>
            </div>
          </div>

          <div class="flex items-center gap-3 pt-4 border-t border-blue-200">
            <button type="submit" class="px-6 py-2.5 bg-gradient-to-r from-blue-600 to-sky-500 hover:from-blue-700 hover:to-sky-600 text-white font-semibold text-sm rounded-lg shadow-sm transition">
              Update Booking
            </button>
            <a href="/booking/view/{{booking.id}}" class="px-4 py-2.5 bg-white hover:bg-blue-50 text-slate-700 font-medium text-sm rounded-lg border border-blue-200 shadow-xs transition">
              Cancel
            </a>
          </div>
        </form>
      </div>

    </main>

    {{> footer}}
  </div>

