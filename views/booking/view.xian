{{> head}}
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">
  {{> sidebar}}

  <div class="md:pl-64 flex-1 flex flex-col min-w-0">
    {{> topbar}}

    <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-5xl w-full mx-auto space-y-6">
      
      {{#if success_msg}}
        <div class="flex items-center space-x-3 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 shadow-sm print:hidden">
          <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="text-sm font-medium">{{success_msg}}</span>
        </div>
      {{/if}}

      <!-- Top Booking Pass Banner -->
      <div class="rounded-xl p-6 sm:p-8 bg-gradient-to-r from-blue-950 via-blue-800 to-sky-700 text-white shadow-md">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="space-y-1">
            <div class="flex items-center space-x-2">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-white/15 border border-white/30">
                {{booking.bookingNumber}}
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold uppercase
                {{#if (eq booking.status 'completed')}}bg-emerald-400/20 text-emerald-200 border border-emerald-300/40
                {{else if (eq booking.status 'checked_in')}}bg-sky-400/25 text-white border border-sky-200/50
                {{else if (eq booking.status 'approved')}}bg-blue-400/25 text-blue-100 border border-blue-200/40
                {{else if (eq booking.status 'pending')}}bg-amber-400/25 text-amber-100 border border-amber-200/40
                {{else}}bg-red-400/25 text-red-100 border border-red-200/40{{/if}}">
                {{booking.status}}
              </span>
              <span class="px-2 py-0.5 rounded text-[11px] font-semibold uppercase bg-white/10 text-sky-100">
                Priority: {{booking.priority}}
              </span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight pt-1">{{booking.subjectName}}</h1>
            <p class="text-blue-100 text-sm">
              {{booking.bookingType}} • {{booking.facilityZone}}
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2 print:hidden">
            <button onclick="window.print()" class="px-3.5 py-2 rounded-lg bg-white/15 hover:bg-white/25 text-white border border-white/30 text-xs font-semibold transition flex items-center space-x-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
              </svg>
              <span>Print Booking Pass</span>
            </button>
            <a href="/booking/edit/{{booking.id}}" class="px-3.5 py-2 rounded-lg bg-white text-blue-900 hover:bg-blue-50 text-xs font-semibold shadow-xs transition">
              Edit Booking
            </a>
            <a href="/booking" class="px-3.5 py-2 rounded-lg bg-blue-900/60 hover:bg-blue-900 text-blue-100 border border-blue-700 text-xs font-medium transition">
              ← All Bookings
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Status Workflow Controls -->
      <div class="bg-white rounded-xl p-5 border border-blue-200 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 print:hidden">
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-blue-900">Booking Status Workflow</h3>
          <p class="text-xs text-slate-500 mt-0.5">Update real-time gate clearance, check-in arrival, or completion status</p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <form method="POST" action="/booking/status/{{booking.id}}" style="display:inline;">
            <input type="hidden" name="status" value="approved" />
            <button type="submit" class="px-3.5 py-1.5 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 text-xs font-semibold transition">
              Approve Booking
            </button>
          </form>

          <form method="POST" action="/booking/status/{{booking.id}}" style="display:inline;">
            <input type="hidden" name="status" value="checked_in" />
            <button type="submit" class="px-3.5 py-1.5 rounded-lg bg-sky-600 hover:bg-sky-700 text-white text-xs font-semibold shadow-xs transition">
              Mark Checked-In
            </button>
          </form>

          <form method="POST" action="/booking/status/{{booking.id}}" style="display:inline;">
            <input type="hidden" name="status" value="completed" />
            <button type="submit" class="px-3.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-xs transition">
              Complete &amp; Check-Out
            </button>
          </form>

          <form method="POST" action="/booking/status/{{booking.id}}" style="display:inline;">
            <input type="hidden" name="status" value="cancelled" />
            <button type="submit" class="px-3.5 py-1.5 rounded-lg bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 text-xs font-semibold transition">
              Cancel Booking
            </button>
          </form>
        </div>
      </div>

      <!-- Two-Column Details Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Subject & Schedule Details -->
        <div class="bg-white rounded-xl p-6 border border-blue-200 shadow-sm space-y-4">
          <h3 class="text-xs font-bold uppercase tracking-wider text-blue-800 pb-2 border-b border-blue-100">
            Subject &amp; Reservation Details
          </h3>
          <div class="space-y-2.5 text-xs">
            <div class="flex justify-between py-1.5 border-b border-blue-50">
              <span class="text-slate-500">Booking Reference</span>
              <span class="font-mono font-bold text-blue-700">{{booking.bookingNumber}}</span>
            </div>
            <div class="flex justify-between py-1.5 border-b border-blue-50">
              <span class="text-slate-500">Subject / Visitor Name</span>
              <span class="font-semibold text-slate-900">{{booking.subjectName}}</span>
            </div>
            <div class="flex justify-between py-1.5 border-b border-blue-50">
              <span class="text-slate-500">Valid ID / Case No.</span>
              <span class="font-mono text-slate-800">{{#if booking.subjectIdNumber}}{{booking.subjectIdNumber}}{{else}}--{{/if}}</span>
            </div>
            <div class="flex justify-between py-1.5 border-b border-blue-50">
              <span class="text-slate-500">Contact Info</span>
              <span class="text-slate-800">{{#if booking.subjectContact}}{{booking.subjectContact}}{{else}}--{{/if}}</span>
            </div>
            <div class="flex justify-between py-1.5 border-b border-blue-50">
              <span class="text-slate-500">Booking Category</span>
              <span class="font-semibold text-blue-700">{{booking.bookingType}}</span>
            </div>
            <div class="flex justify-between py-1.5">
              <span class="text-slate-500">Facility Zone / Post</span>
              <span class="font-semibold text-slate-900">{{booking.facilityZone}}</span>
            </div>
          </div>
        </div>

        <!-- Timing & Duty Officer Details -->
        <div class="bg-white rounded-xl p-6 border border-blue-200 shadow-sm space-y-4">
          <h3 class="text-xs font-bold uppercase tracking-wider text-blue-800 pb-2 border-b border-blue-100">
            Schedule &amp; Assigned Officer
          </h3>
          <div class="space-y-2.5 text-xs">
            <div class="flex justify-between py-1.5 border-b border-blue-50">
              <span class="text-slate-500">Scheduled Date</span>
              <span class="font-semibold text-slate-900">{{formatDate booking.bookingDate}}</span>
            </div>
            <div class="flex justify-between py-1.5 border-b border-blue-50">
              <span class="text-slate-500">Time Slot</span>
              <span class="font-mono font-semibold text-blue-700">{{booking.startTime}}{{#if booking.endTime}} – {{booking.endTime}}{{/if}}</span>
            </div>
            <div class="flex justify-between py-1.5 border-b border-blue-50">
              <span class="text-slate-500">Actual Check-In</span>
              <span class="font-mono text-slate-800">
                {{#if booking.checkedInAt}}{{formatDate booking.checkedInAt}} {{formatTime booking.checkedInAt}}{{else}}Not checked in yet{{/if}}
              </span>
            </div>
            <div class="flex justify-between py-1.5 border-b border-blue-50">
              <span class="text-slate-500">Actual Check-Out</span>
              <span class="font-mono text-slate-800">
                {{#if booking.checkedOutAt}}{{formatDate booking.checkedOutAt}} {{formatTime booking.checkedOutAt}}{{else}}--{{/if}}
              </span>
            </div>
            <div class="flex justify-between py-1.5 border-b border-blue-50">
              <span class="text-slate-500">Assigned Duty Officer</span>
              {{#if booking.Personnel}}
                <a href="/personnel/view/{{booking.Personnel.id}}" class="font-semibold text-blue-700 hover:underline">
                  {{booking.Personnel.firstName}} {{booking.Personnel.lastName}} ({{booking.Personnel.employeeId}})
                </a>
              {{else}}
                <span class="text-slate-400 italic">Unassigned</span>
              {{/if}}
            </div>
            <div class="flex justify-between py-1.5">
              <span class="text-slate-500">Officer Department</span>
              <span class="text-slate-800">{{#if booking.Personnel}}{{booking.Personnel.department}}{{else}}--{{/if}}</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Purpose & Security Remarks -->
      <div class="bg-white rounded-xl p-6 border border-blue-200 shadow-sm space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-blue-800 pb-2 border-b border-blue-100">
          Purpose &amp; Security Clearance Notes
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
          <div class="p-4 rounded-lg bg-blue-50/50 border border-blue-100">
            <div class="font-semibold text-blue-900 mb-1">Booking Purpose / Details:</div>
            <p class="text-slate-700 leading-relaxed">{{#if booking.purpose}}{{booking.purpose}}{{else}}No specific purpose description recorded.{{/if}}</p>
          </div>
          <div class="p-4 rounded-lg bg-blue-50/50 border border-blue-100">
            <div class="font-semibold text-blue-900 mb-1">Security &amp; Clearance Remarks:</div>
            <p class="text-slate-700 leading-relaxed">{{#if booking.remarks}}{{booking.remarks}}{{else}}No security remarks recorded.{{/if}}</p>
          </div>
        </div>
      </div>

    </main>

    {{> footer}}
  </div>

