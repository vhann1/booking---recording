{{> head}}
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">
  {{> sidebar}}

  <div class="md:pl-64 flex-1 flex flex-col min-w-0">
    {{> topbar}}

    <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto space-y-6">
      
      {{#if success_msg}}
        <div class="flex items-center space-x-3 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 shadow-sm">
          <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="text-sm font-medium">{{success_msg}}</span>
        </div>
      {{/if}}

      {{#if error_msg}}
        <div class="flex items-center space-x-3 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 shadow-sm">
          <svg class="w-5 h-5 text-red-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <span class="text-sm font-medium">{{error_msg}}</span>
        </div>
      {{/if}}

      <!-- Page Header -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-2 border-b border-slate-200">
        <div>
          <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Compliance &amp; Document Records</h1>
          <p class="text-slate-500 text-sm mt-0.5">Firearm qualification records, medical clearances, background checks, and certifications</p>
        </div>

        <a href="/document/upload" class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium text-xs shadow-sm transition flex items-center space-x-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
          </svg>
          <span>Upload Document</span>
        </a>
      </div>

      <!-- KPI Summary Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm text-center">
          <div class="text-xs font-semibold uppercase text-slate-500">Total Filed</div>
          <div class="text-2xl font-bold text-slate-900 mt-1">{{stats.totalDocs}}</div>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm text-center">
          <div class="text-xs font-semibold uppercase text-slate-500">Valid / Verified</div>
          <div class="text-2xl font-bold text-emerald-600 mt-1">{{stats.validDocs}}</div>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm text-center">
          <div class="text-xs font-semibold uppercase text-slate-500">Pending Review</div>
          <div class="text-2xl font-bold text-amber-600 mt-1">{{stats.pendingDocs}}</div>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm text-center">
          <div class="text-xs font-semibold uppercase text-slate-500">Expired</div>
          <div class="text-2xl font-bold text-red-600 mt-1">{{stats.expiredDocs}}</div>
        </div>
      </div>

      <!-- Filter Controls -->
      <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm">
        <form method="GET" action="/document" class="grid grid-cols-1 sm:grid-cols-4 gap-3">
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </span>
            <input type="text" name="search" value="{{filters.search}}" placeholder="Search document title..." class="w-full pl-9 pr-3.5 py-2 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-sm transition" />
          </div>

          <div>
            <select name="personnelId" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-sm transition">
              <option value="">All Personnel</option>
              {{#each personnelList}}
                <option value="{{this.id}}" {{#if (eq (json this.id) (json ../filters.personnelId))}}selected{{/if}}>
                  {{this.firstName}} {{this.lastName}} ({{this.employeeId}})
                </option>
              {{/each}}
            </select>
          </div>

          <div>
            <select name="documentType" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-sm transition">
              <option value="">All Document Types</option>
              <option value="ID Proof" {{#if (eq filters.documentType 'ID Proof')}}selected{{/if}}>ID Proof</option>
              <option value="Firearm Certification" {{#if (eq filters.documentType 'Firearm Certification')}}selected{{/if}}>Firearm Certification</option>
              <option value="Medical Clearance" {{#if (eq filters.documentType 'Medical Clearance')}}selected{{/if}}>Medical Clearance</option>
              <option value="Background Check" {{#if (eq filters.documentType 'Background Check')}}selected{{/if}}>Background Check</option>
              <option value="Duty Order" {{#if (eq filters.documentType 'Duty Order')}}selected{{/if}}>Duty Order</option>
              <option value="Training Certificate" {{#if (eq filters.documentType 'Training Certificate')}}selected{{/if}}>Training Certificate</option>
              <option value="Other" {{#if (eq filters.documentType 'Other')}}selected{{/if}}>Other</option>
            </select>
          </div>

          <div class="flex gap-2">
            <select name="status" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 shadow-sm transition">
              <option value="">All Statuses</option>
              <option value="valid" {{#if (eq filters.status 'valid')}}selected{{/if}}>Valid</option>
              <option value="pending" {{#if (eq filters.status 'pending')}}selected{{/if}}>Pending</option>
              <option value="expired" {{#if (eq filters.status 'expired')}}selected{{/if}}>Expired</option>
            </select>
            <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold shadow-sm transition">
              Filter
            </button>
            <a href="/document" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-sm font-semibold transition flex items-center justify-center" title="Reset Filters">
              ↺
            </a>
          </div>
        </form>
      </div>

      <!-- Main Documents Table -->
      <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
        {{#if documents.length}}
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-700 uppercase tracking-wider">
                <tr>
                  <th class="px-5 py-3">Officer</th>
                  <th class="px-5 py-3">Document Title</th>
                  <th class="px-5 py-3">Category</th>
                  <th class="px-5 py-3">Issued / Expiry</th>
                  <th class="px-5 py-3">Status</th>
                  <th class="px-5 py-3 text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-xs">
                {{#each documents}}
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-5 py-3.5">
                      <a href="/personnel/view/{{this.Personnel.id}}" class="font-semibold text-slate-900 hover:text-blue-600 transition block">
                        {{this.Personnel.firstName}} {{this.Personnel.lastName}}
                      </a>
                      <div class="text-[11px] text-slate-400 font-mono">{{this.Personnel.employeeId}} • {{this.Personnel.department}}</div>
                    </td>
                    <td class="px-5 py-3.5">
                      <div class="font-semibold text-slate-800">{{this.documentName}}</div>
                      <div class="text-[11px] text-slate-400 font-mono truncate max-w-xs">{{this.fileName}}</div>
                    </td>
                    <td class="px-5 py-3.5">
                      <span class="inline-block px-2.5 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">
                        {{this.documentType}}
                      </span>
                    </td>
                    <td class="px-5 py-3.5 text-slate-500 whitespace-nowrap">
                      <div>Issued: {{#if this.issuedDate}}{{formatDate this.issuedDate}}{{else}}--{{/if}}</div>
                      <div class="{{#if (eq this.status 'expired')}}text-red-600 font-semibold{{/if}}">
                        Expires: {{#if this.expiryDate}}{{formatDate this.expiryDate}}{{else}}Permanent{{/if}}
                      </div>
                    </td>
                    <td class="px-5 py-3.5">
                      <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium uppercase
                        {{#if (eq this.status 'valid')}}bg-emerald-50 text-emerald-700 border border-emerald-200
                        {{else if (eq this.status 'pending')}}bg-amber-50 text-amber-700 border border-amber-200
                        {{else}}bg-red-50 text-red-700 border border-red-200{{/if}}">
                        {{this.status}}
                      </span>
                    </td>
                    <td class="px-5 py-3.5 text-right space-x-1 whitespace-nowrap">
                      <a href="/document/view/{{this.id}}" class="inline-block px-2.5 py-1 rounded bg-slate-50 hover:bg-slate-100 text-blue-700 border border-slate-200 text-xs font-medium transition">
                        Download
                      </a>
                      <form method="POST" action="/document/delete/{{this.id}}" style="display:inline;" onsubmit="return confirm('Permanently remove this document?')">
                        <button type="submit" class="px-2.5 py-1 rounded bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 text-xs font-medium transition">
                          Delete
                        </button>
                      </form>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>

          <!-- Pagination Bar -->
          <div class="flex items-center justify-between px-5 py-3 bg-slate-50 border-t border-slate-200 text-xs text-slate-600">
            <span>Showing page {{currentPage}} of {{totalPages}}</span>
            <div class="flex space-x-2">
              {{#if (gt currentPage 1)}}
                <a href="/document?page={{subtract currentPage 1}}" class="px-3 py-1 rounded bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 shadow-xs transition">
                  ← Previous
                </a>
              {{/if}}
              {{#if (lt currentPage totalPages)}}
                <a href="/document?page={{add currentPage 1}}" class="px-3 py-1 rounded bg-blue-600 hover:bg-blue-700 text-white font-medium shadow-xs transition">
                  Next →
                </a>
              {{/if}}
            </div>
          </div>
        {{else}}
          <div class="p-12 text-center text-slate-500 space-y-2">
            <svg class="mx-auto h-8 w-8 text-slate-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
            </svg>
            <p class="text-sm font-semibold text-slate-700">No compliance documents found</p>
            <a href="/document/upload" class="inline-block text-xs font-medium text-blue-600 hover:underline">+ Upload Document</a>
          </div>
        {{/if}}
      </div>

    </main>

    {{> footer}}
  </div>
