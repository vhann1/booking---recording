{{> head}}
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-center items-center p-4">
  
  <div class="max-w-md w-full bg-white rounded-xl p-8 border border-slate-200 text-center shadow-md space-y-5">
    <div class="w-14 h-14 rounded-full bg-red-50 text-red-600 flex items-center justify-center text-2xl mx-auto">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
      </svg>
    </div>

    <div>
      <h1 class="text-xl font-bold text-slate-900 mb-1.5">{{#if title}}{{title}}{{else}}System Notice{{/if}}</h1>
      <p class="text-sm text-slate-600">
        {{#if error}}
          {{error}}
        {{else if message}}
          {{message}}
        {{else}}
          An unexpected error occurred while processing your request.
        {{/if}}
      </p>
    </div>

    <div class="flex justify-center gap-3 pt-2">
      <a href="javascript:history.back()" class="px-4 py-2 rounded-lg bg-white hover:bg-slate-50 text-slate-700 font-medium text-xs border border-slate-300 shadow-xs transition">
        ← Go Back
      </a>
      <a href="/dashboard" class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium text-xs shadow-xs transition">
        Return to Dashboard
      </a>
    </div>
  </div>

  <footer class="mt-8 text-center text-xs text-slate-400">
    &copy; 2026 Mindoro State University • Jail Personnel System
  </footer>
</body>
</html>
